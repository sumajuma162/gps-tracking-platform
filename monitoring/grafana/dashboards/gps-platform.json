{
  "uid": "gps-platform",
  "title": "GPS platform overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "gps"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Device connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(gpsgw_connections)"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Records stored / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gpsgw_records_total{outcome=\"stored\"}[5m]))"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Live update lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gpsproc_last_lag_ms"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Services up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up)"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Packets per second by protocol",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol) (rate(gpsgw_packets_total[5m]))",
          "legendFormat": "{{protocol}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Records by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(gpsgw_records_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Decode errors by protocol",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, code) (rate(gpsgw_protocol_errors_total[5m]))",
          "legendFormat": "{{protocol}} {{code}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Ingestion lag p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(gpsgw_ingest_lag_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gpsgw_ingest_lag_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Trackers by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gps_devices",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Queues and positions stream",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gps_queue_items",
          "legendFormat": "{{queue}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "API requests by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(gps_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "API latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gps_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "WebSocket clients",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gps_websocket_clients",
          "legendFormat": "{{kind}}"
        }
      ],
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Processor throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(gpsproc_entries_total[5m])",
          "legendFormat": "entries/s"
        },
        {
          "refId": "B",
          "expr": "rate(gpsproc_alerts_touched_total[5m])",
          "legendFormat": "alerts/s"
        },
        {
          "refId": "C",
          "expr": "rate(gpsproc_errors_total[5m])",
          "legendFormat": "errors/s"
        }
      ],
      "id": 14
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}