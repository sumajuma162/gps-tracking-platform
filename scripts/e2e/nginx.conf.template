worker_processes 1;
pid /tmp/e2e-nginx.pid;
error_log /tmp/e2e-nginx-error.log warn;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  access_log off;
  map $http_upgrade $connection_upgrade { default upgrade; '' close; }
  limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
  upstream backend_app { server 127.0.0.1:8000; }
  upstream frontend_app { server 127.0.0.1:8080; }
  server {   # the frontend container (frontend/nginx-spa.conf)
    listen 8080;
    root __ROOT__/frontend/dist;
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
    location / { add_header Cache-Control "no-cache"; try_files $uri /index.html; }
  }
  server {   # nginx/conf.d/default.conf with local upstreams
    listen 80;
    server_name _;
    client_max_body_size 10m;
    server_tokens off;
    include __ROOT__/nginx/snippets/security-headers.conf;
    location = /health    { proxy_pass http://backend_app; include __ROOT__/nginx/snippets/proxy.conf; }
    location = /readiness { proxy_pass http://backend_app; include __ROOT__/nginx/snippets/proxy.conf; }
    location /api/ { limit_req zone=api burst=40 nodelay; proxy_pass http://backend_app; include __ROOT__/nginx/snippets/proxy.conf; }
    location /ws/ { proxy_pass http://backend_app; include __ROOT__/nginx/snippets/proxy.conf;
      proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 3600s; proxy_send_timeout 3600s; }
    location /admin/ { proxy_pass http://backend_app; include __ROOT__/nginx/snippets/proxy.conf; }
    location /static/ { alias __ROOT__/backend/staticfiles/; }
    location /media/  { alias __ROOT__/backend/media/; }
    location / { proxy_pass http://frontend_app; include __ROOT__/nginx/snippets/proxy.conf; }
  }
}
