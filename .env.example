# Copy to .env and fill in. NEVER commit .env. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object {Get-Random -Max 256}))

# --- Django -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
# Public address of the web app (used in password-reset and invitation emails).
FRONTEND_URL=http://localhost
# 1 in production (HTTPS). 0 only for plain-HTTP localhost development.
REFRESH_COOKIE_SECURE=0

# --- Email (console backend prints emails to the backend log in development) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Fleet Tracking <no-reply@localhost>

# --- Development demo data: password for seeded demo users (never used when DEBUG=0) ---
SEED_DEMO_PASSWORD=change-me-Demo-Pass-1

# --- Database (internal Docker network only) ------------------------------
DATABASE_NAME=gps
DATABASE_USER=gps
DATABASE_PASSWORD=change-me-db-password

# --- Redis (internal Docker network only) ---------------------------------
REDIS_PASSWORD=change-me-redis-password

# Sign-in attempts allowed per IP address. Keep 10/min in production; automated browser tests need more.
THROTTLE_LOGIN=10/min
# Public hostname trackers connect to (shown in each tracker's setup instructions).
TRACKER_SERVER_HOST=gps.example.com

# --- Live map -----------------------------------------------------------------
# Map tiles. The public OpenStreetMap tile servers are NOT for production fleet use (their usage policy): set
# your provider's URL (MapTiler, Stadia, self-hosted...) here. Leave empty for a plain background (offline/tests).
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
MAP_DEFAULT_CENTER=-6.7924,39.2083
MAP_DEFAULT_ZOOM=12
# Vehicle status rules used by the processor.
MOVING_SPEED_KMH=5
OFFLINE_MINUTES=5
NO_GPS_MINUTES=10

# Alerts and commands.
OVERSPEED_WARNING_KMH=80
OVERSPEED_CRITICAL_KMH=100
# Commands not delivered within this time (the tracker never connected) time out.
COMMAND_EXPIRY_HOURS=24
# Email notifications (Celery sends them with retries). The console backend prints instead of sending.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587

# --- Public ports ---------------------------------------------------------
HTTP_PORT=80
TELTONIKA_PUBLIC_PORT=5027

# --- Gateway storage -------------------------------------------------------
# "postgres" stores every position durably before acknowledging it. "memory" (positions lost on restart,
# only the IMEIs in GATEWAY_DEV_DEVICES accepted) exists for gateway development and needs
# GATEWAY_ALLOW_MEMORY_STORAGE=1.
GATEWAY_STORAGE=postgres
GATEWAY_ALLOW_MEMORY_STORAGE=0
GATEWAY_DEV_DEVICES=
# Days of raw tracker traffic kept for troubleshooting (only for trackers with raw logging switched on).
RAW_PACKET_RETENTION_DAYS=14

# --- Webhooks (Phase 9) ----------------------------------------------------
# Seconds to wait for a webhook receiver. Production accepts only https:// URLs that resolve to public addresses
# (protection against requests into your own network). Set the two flags to 1 only for local development.
WEBHOOK_TIMEOUT=10
WEBHOOK_ALLOW_HTTP=0
WEBHOOK_ALLOW_PRIVATE=0

# --- Monitoring and error reporting (Phase 11) ----------------------------
# Bearer token Prometheus sends to the backend's /metrics (also put it in monitoring/prometheus/metrics_token).
METRICS_TOKEN=
# Grafana admin password for `docker compose --profile monitoring up -d` (Grafana listens on 127.0.0.1 only).
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
# Sentry error reporting: leave empty to disable. No personal data is sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
