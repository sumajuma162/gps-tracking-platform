# Production template. Replace every CHANGE_ME value before starting the stack.
# Keep .env private (chmod 600); never commit it or share its contents.
# Generate secrets on the server with: openssl rand -hex 48

# Django and public URLs. Use the same canonical hostname in all four settings.
DJANGO_SECRET_KEY=CHANGE_ME_unique_django_secret
DEBUG=0
ALLOWED_HOSTS=gps.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://gps.yourdomain.com
FRONTEND_URL=https://gps.yourdomain.com
REFRESH_COOKIE_SECURE=1
DEFAULT_TIMEZONE=Africa/Dar_es_Salaam
LOG_LEVEL=INFO

# Internal database and Redis. Use distinct random values; hex secrets avoid URL parsing issues.
DATABASE_NAME=gps
DATABASE_USER=gps
DATABASE_PASSWORD=CHANGE_ME_unique_database_password
REDIS_PASSWORD=CHANGE_ME_different_redis_password

# Public address and listener for trackers.
TRACKER_SERVER_HOST=gps.yourdomain.com
TELTONIKA_PUBLIC_PORT=5027
HTTP_PORT=80
GATEWAY_STORAGE=postgres
GATEWAY_ALLOW_MEMORY_STORAGE=0

# SMTP is required for password-reset and invitation email delivery.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_smtp_username
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
DEFAULT_FROM_EMAIL=Fleet Tracking <no-reply@yourdomain.com>

# Set a production tile service and use its required attribution.
# Do not use the public OpenStreetMap tile server for production fleet traffic.
MAP_TILE_URL=https://tiles.your-provider.example/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=Your map provider
MAP_DEFAULT_CENTER=-6.7924,39.2083
MAP_DEFAULT_ZOOM=12

# Keep production webhook restrictions enabled.
WEBHOOK_TIMEOUT=10
WEBHOOK_ALLOW_HTTP=0
WEBHOOK_ALLOW_PRIVATE=0

# Optional monitoring and error reporting. Required only when enabling those services.
METRICS_TOKEN=CHANGE_ME_if_monitoring_is_enabled
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_if_monitoring_is_enabled
GRAFANA_PORT=3000
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
